# Server-only settings. Never commit the generated .env, tokens, or private data.
# python scripts/bootstrap.py creates a private .env with a random password.
FRED_OWNER_USERNAME=owner
FRED_OWNER_NAME=Owner
FRED_OWNER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Mock requires no API key and makes no external AI requests.
FRED_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FRED_PERSONALITY_INSTRUCTION="Communicate naturally and professionally. Be concise, confident, and clear about uncertainty."

# Omit DATABASE_URL for <project>/data/fred.db, independent of working directory.
# PostgreSQL is optional and has not been validated with a running server.
# DATABASE_URL=postgresql+psycopg://fred:YOUR_PASSWORD@localhost:5432/fred
FRED_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRED_COOKIE_SECURE=false
FRED_SESSION_TTL_HOURS=12
FRED_API_RATE_LIMIT=120
FRED_CHAT_RATE_LIMIT=20
FRED_LOGIN_RATE_LIMIT=10
FRED_OPENAI_TIMEOUT=45

# Memory can be disabled without deleting stored records.
FRED_MEMORY_ENABLED=true
# These capabilities are contracts only; enabling them fails startup in V1.
FRED_VOICE_ENABLED=false
FRED_SMART_HOME_ENABLED=false
FRED_REMOTE_CONTROL_ENABLED=false
FRED_AUTOMATIONS_ENABLED=false

# Future hardware configuration. Wake-word detection must remain local.
FRED_VOICE={"wake_phrase":"Hey Fred","microphone_id":null,"speaker_id":null,"listening_timeout_seconds":8,"conversation_timeout_seconds":60,"silence_timeout_seconds":1.5,"echo_cancellation":"if_supported","wake_word_local_only":true}
# JSON declarations only, not live devices. IDs must be unique; room refs must exist.
FRED_ROOMS=[]
FRED_DEVICES=[]
# Example room: {"id":"office","name":"Office"}
# Example device: {"id":"desk","name":"Desk lamp","kind":"light","room_id":"office","integration":"home_assistant","external_id":"light.desk","actions":["device.turn_on","device.turn_off"]}
